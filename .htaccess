# =============================================================================
# EODB-TaskFlow - Apache settings for the whole system
# =============================================================================

# Never list folder contents; open index.php by default
Options -Indexes
DirectoryIndex index.php

# Friendly error pages instead of Apache's default pages (which show server
# details). The path must match BASE_URL in config/app.php.
ErrorDocument 403 /eodb-taskflow/error.php
ErrorDocument 404 /eodb-taskflow/error.php

# Block documentation, database dumps, logs, backups, and hidden files
<FilesMatch "(?i)(\.(md|sql|log|bak|old|orig|swp|ini|env|sh|dist)$|^\.)">
    Require all denied
</FilesMatch>
